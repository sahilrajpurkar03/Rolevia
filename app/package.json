{
  "name": "rolevia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-assets.mjs",
    "format": "prettier --write src tests e2e scripts next.config.ts playwright.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@serwist/next": "9.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "html-to-text": "10.0.1",
    "lucide-react": "1.44.0",
    "mammoth": "1.12.2",
    "next": "16.3.4",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "serwist": "9.4.1",
    "yauzl": "3.4.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/html-to-text": "9.0.4",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
